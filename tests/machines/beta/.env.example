# Вторая синтетическая машина. Отличается от alpha поставщиком БД: платформа
# обязана обслуживать обе без единой правки — ради этого фикстуры и две.
Platform_Deploy_Dir=/srv/beta
Platform_Vhosts_Dir=/srv/vhosts
Platform_Vhosts_Mount=/var/www/vhosts
Platform_Network=beta-net
Platform_Data_Mount=/srv/data
