[Unit]
Description=Проверка, что конвейер знаний действительно работает
Documentation=file:@STACK_DIR@/README.md
Wants=network-online.target
After=network-online.target docker.service
# Условий на путях здесь намеренно нет: юнит с невыполненным Condition
# пропускается и НЕ считается упавшим, а остановленный контейнер должен
# приводить к failed, а не к тихому «всё хорошо». Ненастроенный стек
# отсекается раньше, в scripts/preflight.sh.
@ONFAILURE@

[Service]
Type=oneshot
WorkingDirectory=@DEPLOY_DIR@
User=@SERVICE_USER@
ExecStart=@STACK_DIR@/scripts/check-health.sh
