# Стек ingester — конвейер знаний.
# Скопировать в stacks/ingester/.env, chmod 600.
#
# ВНИМАНИЕ: отсутствие .env у ВКЛЮЧЁННОГО стека роняет любую compose-команду
# на машине, а не только этот стек.

# Чекаут приложения на девбоксе. Абсолютный путь: относительный в compose
# резолвится от каталога проекта, а не от файла стека.
Ingester_Host_Home_Dir=/home/ec2-user/dev/ingester

# Волты и производное. Каталоги ОБЯЗАНЫ существовать до включения стека:
# отсутствующий host-путь bind-mount'а docker заводит сам и от root, и тогда
# контейнер под Ingester_Run_As в них не запишет. Сюда же смотрит Backup_Files.
Ingester_Data_Dir=/mnt/data/ingester

# uid:gid владельца каталогов выше (`id -u`:`id -g`). Под этим же пользователем
# мак пушит ветку `mac` по SSH, поэтому значение обязано совпадать.
Ingester_Run_As=1000:1000

# База в общем postgres. Пароль обязан совпадать с тем, что уедет
# в db-init/databases.yaml: инициализатор идемпотентен только по факту
# существования и пароль существующему пользователю не обновит.
Ingester_DB_Name=ingester
Ingester_DB_User=ingester
Ingester_DB_Password=change_me

# --- режим сборщика -------------------------------------------------------
# На этой машине не хватает памяти на вызов модели: claude -p ~245 МБ,
# codex exec ~100 МБ, воркер ~80 МБ, свободно ~200 МБ. Поэтому модели не зовём
# вовсе, а работы за S5 ждут воркера, которому хватит. Ничего не теряется:
# сырьё копится, очередь растёт, её разберёт первый же воркер на машине
# посвободнее — хоть из этой же базы.
Ingester_Models_Enabled=false
Ingester_Deferred_Kinds=garbage,extract,merge,brief

# Токен подписки Claude Code (`claude setup-token` на маке).
# Нужен, когда снимете режим сборщика. Пока лежит пустым.
Ingester_Claude_Code_OAuth_Token=

# --- источники ------------------------------------------------------------
# Приём моделей не требует и работает в режиме сборщика. Включать имеет смысл
# сразу: у Fathom транскрипты хранятся не вечно, а конвейер пока только копит.
#
# Ключи — из fathom-scraper, profiles/andrey/fathom-credentials.sh.
# Аккаунт с пустым ключом пропускается с предупреждением; если пусты все,
# а Fathom включён, конфиг откажет — это не опечатка, а защита от тихого
# «источник отключился и никто не заметил».
Ingester_Fathom_Enabled=true
Ingester_Fathom_Key_Shiptify=
Ingester_Fathom_Key_Gmail=
Ingester_Fathom_Key_TWD=

# Этап 2. Папки Meet Recordings и Tactiq; нужен ещё ключ сервисного аккаунта.
Ingester_GDrive_Enabled=false

# --- утренний бриф --------------------------------------------------------
# Отдельный от оповещений канал: оповещения о поломках идут через
# платформенный scripts/notify.sh, а это сводка для Андрея.
# В режиме сборщика брифа нет (он в Ingester_Deferred_Kinds).
Ingester_Telegram_Bot_Token=
Ingester_Telegram_Chat_Id=

Ingester_TZ=Europe/Minsk
Ingester_Log_Level=info
