# tokensale: своя MariaDB в контейнере стека, общий postgres ему не нужен.
#
# Пароль root'а до этого стоял открытым текстом в compose.yaml, то есть в git,
# вопреки CLAUDE.md §7. Старый (`root_password`) считать скомпрометированным
# фактом попадания в историю: при заведении файла задать новый.
#
# Имена локальные, по конвенции CLAUDE.md §7. Контракт образа mariadb
# (MARIADB_*) остаётся слева от `:` в compose.yaml.

Tokensale_DB_Root_Password=ЗАМЕНИТЕ_МЕНЯ
Tokensale_DB_Name=main_db

# Чекаут приложения на хосте. Через переменную, а не хардкодом в compose.yaml:
# путь зависит от машины, а compose.yaml — нет (CLAUDE.md §7).
Tokensale_Host_Home_Dir=/home/ec2-user/dev/tokensale-crm
