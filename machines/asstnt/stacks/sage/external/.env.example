# Config for `health-watch.sh` (#90). Copy to ~/.sage-health-watch.env on a
# machine that is NOT the devbox, fill it in, and `chmod 600` it.
#
#   */2 * * * * /path/to/devbox-asstnt/stacks/sage/external/health-watch.sh \
#                ~/.sage-health-watch.env
#
# A check that runs on the host it is checking cannot report that host being
# gone. The laptop is good enough: a sleeping laptop misses checks, and a
# missed check is silence, which here means "nobody looked" and not "fine".

SAGE_HEALTH_URL=https://api.sage.filinn.ai/health

# The same bot as everything else (#61) -- it is already configured and the
# owner already reads it. Its own token, never logged, never printed.
SAGE_HEALTH_BOT_TOKEN=
# The owner's Telegram user id. Same value as `telegram_identities.telegram_user_id`:
#   select telegram_user_id from telegram_identities;
SAGE_HEALTH_CHAT_ID=

# Optional.
# SAGE_HEALTH_STATE=~/.sage-health-watch.state
# SAGE_HEALTH_TIMEOUT=10
# Checks in a row before it says anything. 1 turns a flaky wifi moment into an
# alarm, and a watcher that cries wolf gets muted.
# SAGE_HEALTH_FAILURES=2
