Quotrum__DB_Host=postgres
Quotrum__DB_User=quotrum
Quotrum__DB_Password=dev_password_change_me
# Имя отсюда И есть то, что заводится в общем postgres: stack.conf ссылается на
# эту переменную, а databases.yaml генерируется из него. Расхождение между тем,
# что читает приложение, и тем, что заводит инициализатор, невозможно по
# построению.
Quotrum__DB_Name=quotrum_stg

Quotrum__DB_URL=postgresql+asyncpg://${Quotrum__DB_User}:${Quotrum__DB_Password}@${Quotrum__DB_Host}:5432/${Quotrum__DB_Name}

