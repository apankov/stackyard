# Ротация логов харнесса Саня (стек `sanya`).
#
# Шаблон: @SANYA_HOME@ подставляет scripts/preflight.sh этого стека из
# Sanya_Host_Home_Dir в stacks/sanya/.env, а результат кладёт рядом —
# harness.conf. Подставлять приходится потому, что logrotate не знает ни cwd,
# ни ${...}: путь к логам обязан быть абсолютным.
#
# Готовый файл НЕ кладётся в /etc/logrotate.d намеренно: оттуда его подхватил
# бы ещё и системный logrotate.timer, и одни и те же файлы ротировались бы
# дважды по двум независимым state-файлам.
#
# Зачем вообще: harness пишет logs/events.jsonl построчно и никогда его не
# подрезает. 26.08.2026 залипшая очередь outbox дала 278k строк cli_error и
# файл на 5.9 ГБ.
#
# Проверить конфиг, ничего не меняя:
#   sudo logrotate -d --state /var/lib/sanya-logrotate/harness.state \
#        <репозиторий>/stacks/sanya/logrotate/harness.conf

@SANYA_HOME@/logs/*.jsonl {
    # copytruncate, а не create. Харнесс открывает файл заново на каждую
    # строку (harness/log.py: `self._path.open("a")`), поэтому и
    # переименование он бы пережил без потерь. Выбран copytruncate потому, что
    # он переживёт и буферизованный логгер с постоянным дескриптором: такой
    # писатель после rename молча писал бы в отвалившийся inode до
    # перезапуска, а после усечения (файл открыт в O_APPEND) продолжит в тот
    # же файл. Цена — максимум одна строка, потерянная между копией и
    # усечением, раз в ротацию.
    copytruncate

    # Времени тут нет намеренно: юнит запускается ежечасно, а `size` (в
    # отличие от `minsize`/`maxsize`) не оглядывается на интервал — ротируем
    # ровно тогда, когда файл перерос порог. Потолок на диске: 200 МБ живого
    # файла + 12 сжатых поколений (jsonl жмётся раз в 10-20).
    size 200M
    rotate 12

    compress
    # Свежеротированный .1 остаётся несжатым: если харнесс всё-таки допишет
    # в него хвост между копией и усечением, строка не потеряется в gzip.
    delaycompress

    missingok
    notifempty
}
