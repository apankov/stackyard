Sanya_Host_Home_Dir=/home/ec2-user/dev/bod-assistant-2
Sanya_Host_DB_Dir=${Sanya_Host_Home_Dir}/db
Sanya_Host_Wiki_Dir=/home/ec2-user/dev/bod-asstnt-wiki-twd
# Имя файла базы вынесено отдельной переменной, потому что оно нужно в двух
# местах: приложению — как путь ВНУТРИ контейнера (ниже), бэкапу — как путь на
# ХОСТЕ (Backup_Sqlite в stack.conf). Каталоги разные, имя одно, и держать его
# в двух местах значит рано или поздно забэкапить не тот файл.
Sanya_DB_File=twd.db
Sanya_DB_Path=/app/db/${Sanya_DB_File}
Sanya_Operator_Port=3456

Sanya_MCP_Server_Port=13001
Sanya_MCP_Server_URL=http://mcp-server:${Sanya_MCP_Server_Port}

Matrix_Server_Port=6167

Langfuse_Tracing_Enabled=false
Langfuse_Public_Key=pk-lf-...
Langfuse_Secret_Key=sk-lf-...
Langfuse_Base_URL=https://cloud.langfuse.com
Langfuse_Environment=dev

Mem0_Qdrant_Host=sanya-qdrant
Mem0_Qdrant_Port=6333
Mem0_Embedder__OpenAI_API_Key=
Mem0_Embedder__Anthropic_API_Key=
Mem0_LLM__OpenAI_API_Key=
Mem0_LLM__Anthropic_API_Key=
Mem0__Use_Gemini=
Mem0__Use_OpenAI=
Mem0__Gemini_API_Key=


# Using Gemini models family
Gemini_Common_API_Key=
Model_Classifier=google:gemini-3.1-flash-lite
Model_Light=google:gemini-2.5-flash
Model_Heavy=google:gemini-3.1-pro-preview
Model_Memory_Extraction=google:gemini-2.5-flash
Model_Fallback=google:gemini-2.5-flash
Model_Classifier__API_Key=${Gemini_Common_API_Key}
Model_Light__API_Key=${Gemini_Common_API_Key}
Model_Heavy__API_Key=${Gemini_Common_API_Key}


# Using OpenAI models family
OpenAI_Common_API_Key=
