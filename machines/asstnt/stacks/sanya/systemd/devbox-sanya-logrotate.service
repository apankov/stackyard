[Unit]
Description=Rotate Sanya harness logs
Documentation=file:@STACK_DIR@/logrotate/harness.conf
# Условия ConditionPathExists здесь намеренно нет: настроенность стека
# проверяет scripts/preflight.sh ДО установки, и он объясняет причину вслух.
# Условие внутри юнита молчало бы — таймер срабатывал бы, не делая ничего, и
# снаружи был бы неотличим от исправного.
#
# Подставляется scripts/systemd.sh: строка OnFailure, если оповещения
# настроены (.env-notify), иначе пустота. Юнит с OnFailure на несуществующий
# обработчик работал бы, но шумел в журнале.
@ONFAILURE@

[Service]
Type=oneshot
# От root: logs/events.jsonl пишет контейнер, файл принадлежит root:root.
# Свой state-файл, а не /var/lib/logrotate/logrotate.status — чтобы не
# пересекаться с системным logrotate.timer, если он на машине включён.
ExecStartPre=/usr/bin/mkdir -p /var/lib/sanya-logrotate
ExecStart=/usr/sbin/logrotate --state /var/lib/sanya-logrotate/harness.state @STACK_DIR@/logrotate/harness.conf
