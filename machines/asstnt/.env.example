# Платформенное для asstnt. Загружается всегда, для любой compose-команды.
#   cp .env.example .env && chmod 600 .env
Platform_Deploy_Dir=/home/ec2-user/dev/devbox-asstnt
Platform_Vhosts_Dir=/home/ec2-user/dev/devbox-asstnt/vhosts
Platform_Vhosts_Mount=/var/www/vhosts
Platform_Network=devbox8-net

# Отдельного тома на этой машине нет: /mnt/data — каталог корневого раздела.
# Пустое значение выключает проверку, и это законное состояние, а не
# забывчивость — иначе host-setup вечно давал бы ложную тревогу.
Platform_Data_Mount=

# nginx здесь пока старее платформенного умолчания.
Platform_Nginx_Image=nginx:1.19-alpine
