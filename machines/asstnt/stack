#!/usr/bin/env bash
# Точка входа машины. Тонкая обёртка: задаёт ROOT_DIR явно и уходит в платформу.
#
# Явно, а не вычислением из пути скрипта, потому что platform/ — симлинк (в
# рабочем пространстве) или вендоренная копия (на машине), и вычисленный путь
# в этих двух случаях разный.
ROOT_DIR="$( cd -P "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"
export ROOT_DIR
exec "$ROOT_DIR/platform/bin/stack.sh" "$@"
