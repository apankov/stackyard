# Секреты стека. Копировать и заполнять на сервере:
#   cp stacks/timesheets/.env.example stacks/timesheets/.env && chmod 600 stacks/timesheets/.env
#
# Значения читает платформа при генерации stacks/mysql/db-init/databases.yaml —
# ссылки на них стоят в stack.conf. Вторая копия пароля где-либо ещё
# разъезжается с этим файлом молча.
Timesheets_DB_Name=timesheets
Timesheets_DB_User=timesheets
Timesheets_DB_Password=
