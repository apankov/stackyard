# Платформенное для devbox6. Загружается всегда, для любой compose-команды.
#   cp .env.example .env && chmod 600 .env
Platform_Deploy_Dir=/mnt/data/devbox6
Platform_Vhosts_Dir=/mnt/data/vhosts
Platform_Vhosts_Mount=/var/www/vhosts
Platform_Network=devbox6-net

# Данные лежат на ОТДЕЛЬНОМ томе — host-setup откажется работать, если он не
# смонтирован. Пусто на машине, где такого тома нет.
Platform_Data_Mount=/mnt/data
