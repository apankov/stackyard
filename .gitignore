# Настоящих машин в этом репозитории НЕТ: он публичный, а домены и состав
# стеков клиента в публичном репозитории — ровно та утечка, ради которой всё
# разделение и делалось. Машины живут своими приватными репозиториями.
#
# В tests/machines/ лежат СИНТЕТИЧЕСКИЕ фикстуры: две конфигурации, на которых
# гоняется движок. Их .env — тестовые значения, но в git им всё равно не место:
# образец рядом, и путать образец с заполненным файлом не стоит нигде.
tests/machines/*/.env
tests/machines/*/.env-stacks
tests/machines/*/stacks/*/.env
!tests/machines/*/.env.example
!tests/machines/*/.env-stacks.example
!tests/machines/*/stacks/*/.env.example
profiles/stacks/*/.env

# Состояние машины: всё, что описывает ЭТУ машину и генерируется, а не пишется
# руками. Сертификаты, ключ ACME-аккаунта, список баз с паролями, include'ы
# nginx. В git этому места нет — ни как секрету, ни как второму источнику правды.
tests/machines/*/state/*
!tests/machines/*/state/.keepit
tests/machines/*/dumps/*
!tests/machines/*/dumps/.keepit

# Платформа, установленная в фикстуры их же bootstrap'ом. Дубликат того, что
# лежит рядом в platform/ и profiles/.
tests/machines/*/.stackyard/
tests/machines/*/platform
tests/machines/*/profile
tests/machines/*/.vendor.lock
