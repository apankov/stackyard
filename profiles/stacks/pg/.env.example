# Credentials and paths for the pg stack. Copy into the machine's directory:
#   cp profile/stacks/pg/.env.example stacks/pg/.env && chmod 600 stacks/pg/.env

# The DBMS superuser. The prefix is deliberately Pg_ and not Postgres_:
# Postgres_* are the keys consumers use to order a database, and a matching
# prefix would make the pg stack a consumer of itself.
Pg_Root_User=postgres
Pg_Root_Password=CHANGE_ME
Pg_Root_DB=postgres

Pg_Data_Dir=/mnt/data/postgres

# Set this only if the stack was copied into the machine's stacks/ (detached
# from the profile).
# Pg_Stack_Dir=${Platform_Deploy_Dir}/stacks/pg
