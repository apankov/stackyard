# Креды и пути стека pg. Копировать в машинный каталог:
#   cp profile/stacks/pg/.env.example stacks/pg/.env && chmod 600 stacks/pg/.env

# Суперпользователь СУБД. Префикс Pg_, а не Postgres_, намеренно: Postgres_* —
# это ключи заказа базы у потребителей, и совпадение префиксов сделало бы стек
# pg потребителем самого себя.
Pg_Root_User=postgres
Pg_Root_Password=
Pg_Root_DB=postgres

Pg_Data_Dir=/mnt/data/postgres

# Задать, только если стек скопирован в машинный stacks/ (отцеплен от профиля).
# Pg_Stack_Dir=${Platform_Deploy_Dir}/stacks/pg
