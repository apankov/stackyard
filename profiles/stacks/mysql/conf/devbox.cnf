# Настройки общего mysqld. Файлом, а не `SET GLOBAL` после старта: глобальная
# переменная живёт до первого перезапуска контейнера, и настройка исчезает ровно
# тогда, когда контейнер пересоздали — то есть посреди обычного `up -d`.
#
# Проверять надо у РАБОТАЮЩЕГО сервера, а не по этому файлу: если образ читает
# конфиги не из /etc/mysql/conf.d, файл на месте, а настройки нет.
# Это и делает scripts/health.sh стека.

[mysqld]

# ONLY_FULL_GROUP_BY выключен: legacy-код на Kohana пишет GROUP BY без
# перечисления всех колонок, и с включённым режимом запросы падают.
# В MySQL 5.5 этого режима нет в умолчаниях вовсе, строка здесь — защита от
# переезда на 5.7+, где он включён по умолчанию.
sql_mode = NO_ENGINE_SUBSTITUTION

character-set-server = utf8
collation-server     = utf8_general_ci

[client]
default-character-set = utf8
