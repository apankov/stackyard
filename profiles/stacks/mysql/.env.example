# Secrets and paths for the mysql stack. Copy and fill in on the machine:
#   cp profile/stacks/mysql/.env.example stacks/mysql/.env && chmod 600 stacks/mysql/.env
#
# Note the destination path: a stack's .env ALWAYS lives in the machine's
# stacks/<stack>/, even when the stack itself came from the profile. The secret
# belongs to the machine, not to the profile: the profile is updated wholesale,
# a password inside it would be overwritten by the next update, and the
# profile's git would see it.

# The root password. CHANGE_ME is a deliberately wrong placeholder: it exists so
# that `./dc --all-stacks --examples config -q` can check the syntax on a
# machine with no secrets. If it ever reaches a real machine, host-setup says
# so.
Mysql_Root_Password=CHANGE_ME

# The data directory on the host.
Mysql_Data_Dir=/mnt/data/mysql

# Where the stack itself lives. The default points into the profile; you need
# to set this only if you COPIED the stack into the machine's stacks/ (detached
# from the profile) -- then uncomment the line below.
# Mysql_Stack_Dir=${Platform_Deploy_Dir}/stacks/mysql
