# Секреты и пути стека mysql. Копировать и заполнять на машине:
#   cp profile/stacks/mysql/.env.example stacks/mysql/.env && chmod 600 stacks/mysql/.env
#
# Обратите внимание на путь назначения: .env стека ВСЕГДА лежит в машинном
# stacks/<стек>/, даже когда сам стек приехал из профиля. Секрет принадлежит
# машине, а не профилю: профиль обновляется целиком, и пароль внутри него
# затёрло бы следующим обновлением, а git профиля его бы увидел.

# Пароль root. Без него mysqld не поднимется: в compose стоит `:?`.
Mysql_Root_Password=

# Датадир на хосте.
Mysql_Data_Dir=/mnt/data/mysql

# Где лежит сам стек. Значение по умолчанию указывает в профиль; задавать его
# нужно, только если вы СКОПИРОВАЛИ стек в машинный stacks/ (отцепились от
# профиля) — тогда раскомментируйте строку ниже.
# Mysql_Stack_Dir=${Platform_Deploy_Dir}/stacks/mysql
