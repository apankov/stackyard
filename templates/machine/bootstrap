#!/usr/bin/env bash
#
# Fetch the stackyard this machine runs on.
#
# The one file that has to work BEFORE the platform exists, so it is
# self-contained: plain bash, sourcing nothing from platform/. It is also the
# only part of the platform committed here — the platform itself is not kept in
# a machine's git.
#
#   git clone <machine repository> && cd <machine> && ./bootstrap
#
# Pinned by COMMIT rather than by an archive hash. Automatically generated
# archives are not guaranteed to be byte-stable — their format has changed
# before, breaking checksums. A commit is immutable by definition.
#
# For platform development: STACKYARD_SOURCE=/path/to/local/stackyard ./bootstrap
# uses a local directory instead of the network. That is also the offline
# installation mode.

set -euo pipefail

ROOT="$( cd -P "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"
LOCK="$ROOT/stackyard.lock"
DEST="$ROOT/.stackyard"

[ -f "$LOCK" ] || { echo "Error: no $LOCK — it is unknown which stackyard is required" >&2; exit 2; }

val() { grep -E "^$1=" "$LOCK" | tail -n 1 | cut -d= -f2- | tr -d '"'"'"; }
REPO="$(val repo)"; VERSION="$(val version)"; COMMIT="$(val commit)"

[ -n "$COMMIT" ] || { echo "Error: $LOCK does not set commit" >&2; exit 2; }

# What counts as "already installed". In network mode, the commit from the
# lock: that is what the machine is supposed to have. In local mode, the
# source's HEAD: that is where the platform is being edited, and comparing
# against the lock would mean an edit never reaches the machine until the lock
# is moved.
want="$COMMIT"
[ -n "${STACKYARD_SOURCE:-}" ] && want="$( cd "$STACKYARD_SOURCE" && git rev-parse HEAD )"

# The layout of .stackyard/:
#
#   versions/<commit>/     one directory per installed version
#   current -> versions/…  the version the machine runs
#   previous -> versions/… the one before it, kept for a rollback
#
# .stackyard itself is NEVER replaced, only the `current` link inside it. This
# is what the whole layout is for. A bind mount pins the directory it was
# started on, not its path: when this script used to `rm -rf .stackyard` and
# put a fresh copy in its place, a running nginx was left mounted onto deleted
# directories and served no domains at all until it was recreated. nginx now
# mounts .stackyard (see platform/compose/nginx.yaml) and follows `current` on
# every reload, so an update reaches it without a restart.
VERSIONS="$DEST/versions"
NEW="$VERSIONS/$want"

# Swapping a link must be a rename: `ln -sfn` is an unlink followed by a
# symlink, and an nginx reload landing between the two finds no platform at
# all. `mv` onto a link that points at a directory moves INTO that directory
# unless told not to follow it, and the flag is spelled differently in GNU
# (-T) and BSD (-h) mv.
swap_link() {
  local target="$1" link="$2"
  rm -f "$link.tmp"
  ln -s "$target" "$link.tmp"
  mv -T "$link.tmp" "$link" 2>/dev/null || mv -h "$link.tmp" "$link"
}

# The flat layout this replaced: the whole repository straight in .stackyard/.
# It is MOVED into versions/ rather than deleted. A rename keeps every inode,
# so a container still mounted onto the old platform/ keeps seeing its files —
# deleting it here would blind nginx exactly the way this layout exists to
# stop.
if [ -d "$DEST/platform" ] && [ ! -L "$DEST/current" ]; then
  old="$(cat "$DEST/.commit" 2>/dev/null || echo unknown)"
  echo "moving the platform already installed ($old) into .stackyard/versions/"
  mv "$DEST" "$DEST.flat"
  mkdir -p "$VERSIONS"
  mv "$DEST.flat" "$VERSIONS/$old"
  swap_link "versions/$old" "$DEST/current"
fi

if [ "$(readlink "$DEST/current" 2>/dev/null)" = "versions/$want" ] \
   && [ "$(cat "$NEW/.commit" 2>/dev/null)" = "$want" ]; then
  echo "stackyard $VERSION ($want) is already in place"
elif [ "$(cat "$NEW/.commit" 2>/dev/null)" = "$want" ]; then
  # Installed earlier and still kept — typically the previous version, which
  # is what a rollback asks for. It is not fetched a second time.
  echo "stackyard $VERSION ($want) is already downloaded, switching to it"
else
  rm -rf "$DEST.tmp" "$NEW"
  mkdir -p "$VERSIONS"
  if [ -n "${STACKYARD_SOURCE:-}" ]; then
    echo "stackyard from a local directory: $STACKYARD_SOURCE"
    [ -d "$STACKYARD_SOURCE" ] || { echo "Error: no $STACKYARD_SOURCE" >&2; exit 2; }
    mkdir -p "$DEST.tmp"
    # Through git archive rather than cp: neither .git nor anyone's uncommitted
    # edits should end up in the copy — otherwise "local mode" would quietly
    # differ from what a machine gets over the network.
    ( cd "$STACKYARD_SOURCE" && git archive HEAD ) | tar -x -C "$DEST.tmp"
    got="$( cd "$STACKYARD_SOURCE" && git rev-parse HEAD )"
    printf '%s\n' "$got" > "$DEST.tmp/.commit"
    # Local mode deliberately does NOT refuse on a mismatch with the lock: it
    # exists precisely to install a version that has not been released yet. But
    # it must not stay silent — otherwise the machine runs something other than
    # what is recorded, and the lock does not show it.
    if [ "$got" != "$COMMIT" ]; then
      echo "  NOTE: local HEAD $got does not match stackyard.lock ($COMMIT)." >&2
      echo "  The machine is running an unpinned version. Pin it: ./bin/pin.sh <machine>" >&2
    fi
  else
    echo "stackyard $VERSION ($COMMIT): fetching $REPO"
    command -v git >/dev/null || { echo "Error: git is required" >&2; exit 2; }

    # Clone the default branch and check out the PINNED COMMIT.
    #
    # Not `--branch "$VERSION"`: a tag is decoration. The pin is by commit, and
    # requiring a tag to exist breaks installation wherever nobody created one
    # — repository present, commit present, no tags, and bootstrap fails.
    #
    # No --depth: a shallow clone truncates history, and the required commit
    # may lie beyond it. The repository is small, and a full clone is cheaper
    # than guessing how deep to go.
    git clone --quiet "$REPO" "$DEST.tmp" || { rm -rf "$DEST.tmp"; echo "Error: could not clone $REPO" >&2; exit 1; }
    if ! ( cd "$DEST.tmp" && git checkout --quiet "$COMMIT" ) 2>/dev/null; then
      echo "REFUSING: commit $COMMIT is not in $REPO." >&2
      echo "  Either it was never pushed, or stackyard.lock has a typo." >&2
      rm -rf "$DEST.tmp"; exit 1
    fi
    got="$( cd "$DEST.tmp" && git rev-parse HEAD )"
    [ "$got" = "$COMMIT" ] || { echo "REFUSING: after checkout HEAD=$got, expected $COMMIT" >&2; rm -rf "$DEST.tmp"; exit 1; }
    printf '%s\n' "$got" > "$DEST.tmp/.commit"
    rm -rf "$DEST.tmp/.git"
  fi
  mv "$DEST.tmp" "$NEW"
  echo "stackyard $VERSION ($want) downloaded into .stackyard/versions/"
fi

prev="$(readlink "$DEST/current" 2>/dev/null || true)"
if [ "$prev" != "versions/$want" ]; then
  swap_link "versions/$want" "$DEST/current"
  [ -n "$prev" ] && swap_link "$prev" "$DEST/previous"
  echo "stackyard $VERSION ($want) is now current"
fi

# Everything except current and previous goes. previous stays for a rollback,
# and because a container started before this update may still be mounted
# onto it: mysql's conf directory, for instance, is resolved when mysql
# starts, not when it reads it. A container that has outlived TWO updates is
# left mounted onto a deleted version; it gets the current one on its next
# start.
keep_cur="$(readlink "$DEST/current" 2>/dev/null || true)"
keep_prev="$(readlink "$DEST/previous" 2>/dev/null || true)"
for d in "$VERSIONS"/* "$VERSIONS"/.[!.]*; do
  [ -e "$d" ] || continue
  case "versions/${d##*/}" in "$keep_cur"|"$keep_prev") continue ;; esac
  rm -rf "$d"
done
rm -rf "$DEST.tmp"

# The layers are attached as symlinks inside the machine: compose and the
# wrappers refer to ./platform and ./profile and must not care where those came
# from.
#
# A real directory in that place is a refusal, not a reason to delete it.
#
# `ln -sfn TARGET DIR`, when DIR is an existing DIRECTORY, does not replace it
# but creates a link INSIDE it: the result is platform/platform while
# platform/ itself stays as it was — and the command still succeeds. That is
# what a machine on the older layout looks like (its platform/ is in git):
# bootstrap would report success while the wrappers then said the platform was
# missing, with nothing connecting the two.
for layer in platform profile; do
  p="$ROOT/$layer"
  if [ -e "$p" ] && [ ! -L "$p" ]; then
    echo "REFUSING: $p exists and is not a symlink." >&2
    echo "  The platform arrives in .stackyard/ and is attached by a link; a real" >&2
    echo "  directory here means the older repository layout — you are probably" >&2
    echo "  on the wrong branch. Check with: git branch --show-current" >&2
    exit 1
  fi
done
# Through `current`, so the links in the machine root never change again: an
# update is the swap of one link inside .stackyard.
ln -sfn .stackyard/current/platform "$ROOT/platform"
ln -sfn .stackyard/current/profiles "$ROOT/profile"

# Reporting success without checking the result is not allowed: that is exactly
# how bootstrap came to say "done" while the wrappers said the platform was
# missing.
for probe in platform/bin/stack.sh platform/bin/host-setup.sh profile/stacks; do
  [ -e "$ROOT/$probe" ] && continue
  echo "REFUSING: after installation there is no $probe." >&2
  echo "  The platform was downloaded but attached incorrectly. Remove" >&2
  echo "  $ROOT/platform, $ROOT/profile and $ROOT/.stackyard and try again." >&2
  exit 1
done
[ -x "$ROOT/platform/bin/stack.sh" ] || {
  echo "REFUSING: platform/bin/stack.sh is not executable." >&2
  echo "  Check that the clone did not lose file modes (core.fileMode)." >&2
  exit 1
}

# The machine's own step, once the platform is in place.
#
# It lives in a separate file because THIS one is a platform file: ./bin/pin.sh
# overwrites bootstrap from the template whenever they differ, so machine
# specific code added here would disappear at the next platform update without
# a word. bootstrap.local belongs to the machine and nobody rewrites it.
#
# Anything a particular machine has to fetch or prepare before host-setup goes
# there: a vendored toolkit pulled from its own repository, a checkout of an
# application, a directory only this machine needs.
#
# A failure is reported but not fatal, and the exit code of bootstrap keeps
# answering for the platform alone: the platform is already installed by this
# point, and making an optional machine step able to fail the install would
# mean a machine that cannot bootstrap because a side repository is down.
if [ -x "$ROOT/bootstrap.local" ]; then
  echo
  echo "Machine step: ./bootstrap.local"
  ( cd "$ROOT" && ./bootstrap.local ) || echo "WARNING: bootstrap.local exited with $?" >&2
elif [ -f "$ROOT/bootstrap.local" ]; then
  echo "WARNING: $ROOT/bootstrap.local is not executable — skipped (chmod +x)" >&2
fi

# nginx reads the platform through the stable .stackyard mount, so what it
# needs after an update is a reload — `./stack sync` does one after nginx -t.
# Except for an nginx started before that mount existed: it is still pinned to
# the directories of its own version, and only a recreate gives it the new
# mount. Once; after that no bootstrap needs one again.
#
# The containers themselves are NOT touched here: bootstrap must not restart
# anything on a running machine without being asked.
if command -v docker >/dev/null 2>&1 && [ -n "$(docker ps -q --filter name='^nginx$' 2>/dev/null)" ]; then
  echo
  if docker inspect nginx --format '{{range .Mounts}}{{.Destination}} {{end}}' 2>/dev/null \
       | grep -qw /stackyard/platform; then
    echo "nginx follows .stackyard/current; it picks up this platform on its next"
    echo "reload. To reload now, after nginx -t: ./stack sync"
  else
    echo "NOTE: nginx was started before the platform got a stable mount and is"
    echo "  still pinned to the directories of the version it started on. Recreate"
    echo "  it once — after that no ./bootstrap needs a restart:"
    echo "    ./dc up -d --force-recreate nginx     # upstreams must be up first"
  fi
fi

echo "Done. Next: sudo ./host-setup --check"
