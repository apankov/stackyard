#!/usr/bin/env bash
#
# Забрать stackyard, на котором работает эта машина.
#
# Единственный файл, который обязан работать ДО того, как платформа появилась,
# поэтому он самодостаточен: чистый bash, ничего из platform/ не подключает.
# Он же единственный, что здесь коммитится из платформенной части — сама
# платформа в git машины не лежит.
#
#   git clone <репозиторий машины> && cd <машина> && ./bootstrap
#
# Закрепление — по КОММИТУ, а не по хешу архива. Автоматические архивы GitHub
# (/archive/refs/tags/*.tar.gz) байт-стабильными не гарантированы: их формат
# уже менялся, ломая чек-суммы. Коммит неизменен по определению.
#
# Для разработки платформы: STACKYARD_SOURCE=/путь/к/локальному/stackyard ./bootstrap
# берёт локальный каталог вместо сети. Это же режим установки без интернета.

set -euo pipefail

ROOT="$( cd -P "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"
LOCK="$ROOT/stackyard.lock"
DEST="$ROOT/.stackyard"

[ -f "$LOCK" ] || { echo "Ошибка: нет $LOCK — неизвестно, какой stackyard нужен" >&2; exit 2; }

val() { grep -E "^$1=" "$LOCK" | tail -n 1 | cut -d= -f2- | tr -d '"'"'"; }
REPO="$(val repo)"; VERSION="$(val version)"; COMMIT="$(val commit)"

[ -n "$COMMIT" ] || { echo "Ошибка: в $LOCK не задан commit" >&2; exit 2; }

# Что считать «уже установленным». В сетевом режиме — коммит из lock: он и есть
# то, что машине полагается. В локальном — HEAD источника: там платформу как раз
# правят, и сверка с lock означала бы, что правка не доезжает до машины, пока
# не передвинут lock. Ровно на этом я и попался при разработке.
want="$COMMIT"
[ -n "${STACKYARD_SOURCE:-}" ] && want="$( cd "$STACKYARD_SOURCE" && git rev-parse HEAD )"

if [ -f "$DEST/.commit" ] && [ "$(cat "$DEST/.commit")" = "$want" ]; then
  echo "stackyard $VERSION ($want) уже на месте"
else
  rm -rf "$DEST.tmp" "$DEST"
  if [ -n "${STACKYARD_SOURCE:-}" ]; then
    echo "stackyard из локального каталога: $STACKYARD_SOURCE"
    [ -d "$STACKYARD_SOURCE" ] || { echo "Ошибка: нет $STACKYARD_SOURCE" >&2; exit 2; }
    mkdir -p "$DEST.tmp"
    # Через git archive, а не cp: в копию не должны попасть ни .git, ни чужие
    # незакоммиченные правки — иначе «локальный режим» тихо отличался бы от того,
    # что получит машина из сети.
    ( cd "$STACKYARD_SOURCE" && git archive HEAD ) | tar -x -C "$DEST.tmp"
    got="$( cd "$STACKYARD_SOURCE" && git rev-parse HEAD )"
    printf '%s\n' "$got" > "$DEST.tmp/.commit"
    # Локальный режим намеренно НЕ отказывает при расхождении с lock: он для
    # того и существует, чтобы поставить ещё не выпущенную версию. Но молчать
    # нельзя — иначе машина работает не на том, что записано, и по lock этого
    # не видно.
    if [ "$got" != "$COMMIT" ]; then
      echo "  ВНИМАНИЕ: локальный HEAD $got не совпадает с stackyard.lock ($COMMIT)." >&2
      echo "  Машина работает на непроверенной версии. Закрепить: ./bin/pin.sh <машина>" >&2
    fi
  else
    echo "stackyard $VERSION ($COMMIT): получаю $REPO"
    command -v git >/dev/null || { echo "Ошибка: нужен git" >&2; exit 2; }

    # Клонируем ветку по умолчанию и переходим на ЗАКРЕПЛЁННЫЙ КОММИТ.
    #
    # Не `--branch "$VERSION"`: тег — это украшение. Закрепление идёт по
    # коммиту, и требовать существования тега значит ломать установку там, где
    # его просто не создали. Ровно это и обнаружилось при первой публикации:
    # репозиторий на месте, коммит на месте, тегов нет — и bootstrap падал.
    #
    # Без --depth: глубина отсекает историю, а нужный коммит может лежать за
    # её пределами. Репозиторий маленький, полный клон дешевле, чем догадки
    # о том, насколько углубляться.
    git clone --quiet "$REPO" "$DEST.tmp" || { rm -rf "$DEST.tmp"; echo "Ошибка: не удалось склонировать $REPO" >&2; exit 1; }
    if ! ( cd "$DEST.tmp" && git checkout --quiet "$COMMIT" ) 2>/dev/null; then
      echo "ОТКАЗ: коммита $COMMIT нет в $REPO." >&2
      echo "  Либо его не запушили, либо в stackyard.lock опечатка." >&2
      rm -rf "$DEST.tmp"; exit 1
    fi
    got="$( cd "$DEST.tmp" && git rev-parse HEAD )"
    [ "$got" = "$COMMIT" ] || { echo "ОТКАЗ: после checkout HEAD=$got, а ожидался $COMMIT" >&2; rm -rf "$DEST.tmp"; exit 1; }
    printf '%s\n' "$got" > "$DEST.tmp/.commit"
    rm -rf "$DEST.tmp/.git"
  fi
  mv "$DEST.tmp" "$DEST"
  echo "stackyard $VERSION ($COMMIT) установлен в .stackyard/"
fi

# Слои подключаются симлинками внутрь машины: compose и обёртки обращаются к
# ./platform и ./profile, и им не должно быть важно, откуда те взялись.
#
# Настоящий каталог на этом месте — отказ, а не повод его снести.
#
# `ln -sfn TARGET DIR`, когда DIR это существующий КАТАЛОГ, не заменяет его, а
# создаёт ссылку ВНУТРИ него: получается platform/platform, а сам platform/
# остаётся прежним. Команда при этом завершается успешно. Так выглядит машина,
# оставшаяся на старой раскладке (её platform/ лежит в git) — bootstrap
# рапортовал «Готово», а обёртки потом говорили «Платформы нет», и связать одно
# с другим было нечем.
for layer in platform profile; do
  p="$ROOT/$layer"
  if [ -e "$p" ] && [ ! -L "$p" ]; then
    echo "ОТКАЗ: $p существует и не является симлинком." >&2
    echo "  Платформа приезжает в .stackyard/ и подключается ссылкой; настоящий" >&2
    echo "  каталог здесь означает старую раскладку репозитория — вероятно, вы" >&2
    echo "  не на той ветке. Проверьте: git branch --show-current" >&2
    exit 1
  fi
done
ln -sfn .stackyard/platform "$ROOT/platform"
ln -sfn .stackyard/profiles "$ROOT/profile"

# Отчитываться об успехе, не проверив результат, нельзя: именно так и появилось
# расхождение между «Готово» у bootstrap и «Платформы нет» у обёрток.
for probe in platform/bin/stack.sh platform/bin/host-setup.sh profile/stacks; do
  [ -e "$ROOT/$probe" ] && continue
  echo "ОТКАЗ: после установки нет $probe." >&2
  echo "  Платформа скачалась, но подключилась неверно. Уберите $ROOT/platform," >&2
  echo "  $ROOT/profile и $ROOT/.stackyard и повторите." >&2
  exit 1
done
[ -x "$ROOT/platform/bin/stack.sh" ] || {
  echo "ОТКАЗ: platform/bin/stack.sh не исполняем." >&2
  echo "  Проверьте, что клон не потерял права доступа (core.fileMode)." >&2
  exit 1
}

# Каталог .stackyard заменён ЦЕЛИКОМ (rm -rf выше), а platform/ — симлинк в
# него. Контейнер, запущенный до этого, остался с bind-mount'ом на удалённый
# каталог: путь в docker inspect прежний, а файлов по нему ноль. Проявляется
# это не как «платформа обновилась», а как ошибка во vhost'е —
# «open() .../snippets/letsencrypt.conf failed (2: No such file or directory)»,
# — и чинить идут vhost, который ни при чём.
#
# Сами контейнеры здесь НЕ трогаем: bootstrap не должен ничего перезапускать на
# работающей машине без спроса. Но промолчать тоже нельзя.
if command -v docker >/dev/null 2>&1 && [ -n "$(docker ps -q 2>/dev/null)" ]; then
  echo
  echo "ВНИМАНИЕ: контейнеры запущены и смонтировали ПРЕЖНИЙ platform/."
  echo "  Пока их не пересоздать, они видят пустые каталоги платформы:"
  echo "    ./dc up -d"
  echo "  Проверить, что видит живой nginx: ./stack --check"
fi

echo "Готово. Дальше: sudo ./host-setup --check"
