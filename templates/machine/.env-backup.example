# Backing up this machine's data.
#
#   cp .env-backup.example .env-backup && chmod 600 .env-backup
#
# IMPORTANT: this file is deliberately NOT in docker-compose.sh's --env-file
# list. Backups are not a stack; one more mandatory --env-file would be another
# way to break EVERY compose command on the machine at once when the file is
# absent. Only backup.sh and its companions read it.
#
# For the same reason host-setup.sh cannot find .env-backup in the list it
# derives from docker-compose.sh — it checks for it separately.

# ---------------------------------------------------------------------- S3

# The bucket name. Without s3:// and without slashes.
Backup_S3_Bucket=

# This machine's prefix inside the bucket. Required, with no default: a bucket
# is often shared by several machines, and a forgotten value would mean dumps
# landing in another machine's directory, on top of its dumps. Unique per
# machine — bin/audit-isolation.sh checks that.
#
# The resulting layout is:
#   s3://<bucket>/<prefix>/<provider>/<db>/<UTC-timestamp>.dump.gpg
#   s3://<bucket>/<prefix>/<provider>/_globals/<UTC-timestamp>.sql.gpg
#   s3://<bucket>/<prefix>/sqlite/<db name without .db>/<UTC-timestamp>.db.gz.gpg
#
# One prefix per source, so that lifecycle rules and the freshness check apply
# to each source separately rather than to the bucket as a whole.
Backup_S3_Prefix=

Backup_AWS_Region=us-east-1

# Empty means use the instance's IAM role. That is the preferred path: no
# long-lived key is stored on the machine at all. Fill these in only when the
# instance has no role.
Backup_AWS_Access_Key_Id=
Backup_AWS_Secret_Access_Key=

# THE PERMISSIONS THAT SUFFICE, and no more should be granted: s3:PutObject and
# s3:ListBucket on <bucket>/<prefix>/*. Do NOT grant s3:DeleteObject — a script
# allowed to delete inside a backup bucket is a script that, in the wrong
# hands, erases the entire history. Retention in S3 is done with the bucket's
# lifecycle policy, not from here. That policy should also include
# AbortIncompleteMultipartUpload, or aborted uploads accumulate invisibly.

# --------------------------------------------------------------------- GPG

# The recipient's fingerprint or email. The key is GENERATED OFF THIS MACHINE:
# a private key on the machine defeats the whole point of encryption — whoever
# obtains the machine would obtain the data too. Only the public half lives
# here.
Backup_GPG_Recipient=

# The public key lives in the repository — it is public. It is imported into
# root's keyring on the first run.
Backup_GPG_Pubkey=gpg/backup-pubkey.asc

# ------------------------------------------- the local buffer and disk space

# The directory for the temporary file and the local generations.
#
# Check whether this path is on a separate volume. If it shares a partition
# with the data being dumped, the local copy competes for space with the
# databases, the docker images and the container logs.
Backup_Local_Dir=/mnt/data/backups

# How many generations to keep locally AFTER a successful upload to S3.
# 0 keeps nothing and deletes each dump as soon as the upload is confirmed.
# 1 is the compromise: a quick rollback without reaching for S3, at the cost of
# one dump on disk.
Backup_Local_Keep=1

# The lower bound on free space. A run will not start if, after writing the
# largest expected dump (estimated from the previous run), less than this would
# remain free. When space runs short the local generations are dropped FIRST —
# the backup still goes to S3. A backup that fills the disk is not insurance
# but a second incident.
Backup_Min_Free_MB=1024

# ---------------------------------------------------------------- sources

# The S3 prefix for the shared DBMS's dumps. Defaults to the provider stack's
# name. A machine that ALREADY writes under a different prefix must state it
# here: changing the prefix on a running machine means new dumps go somewhere
# else while check-backups.sh keeps looking in the old place and reports "no
# backups" for healthy backups.
# Backup_DB_Prefix=

# The list of databases is deliberately NOT set here — it is asked of the DBMS
# itself. A hardcoded list means the next database someone creates silently
# goes unbacked, and that is discovered during a restore.

# Everything other than the shared DBMS's databases is declared BY THE STACKS
# themselves, through Backup_Sqlite / Backup_Files / Backup_Volume in
# stacks/<stack>/stack.conf. What remains here is what belongs to the machine:
# the bucket, the keys, rotation and thresholds.
#
# Note that a SQLite file's name determines its S3 prefix (sqlite/<name without
# .db>), and check-backups.sh computes the same prefix: changing the path after
# the first run starts a new backup history under a new prefix.

# ---------------------------------------------------------------- checking

# check-backups.sh considers a source healthy when S3 holds an object under its
# prefix that is newer than the given age and larger than the given size. 26
# hours rather than 24: a daily timer with RandomizedDelaySec can drift, and
# the check must not raise an alarm over that.
Backup_Max_Age_Hours=26

# A truncated dump is almost always tiny. This threshold rejects "the file
# exists, the data does not" — a failure that otherwise looks like success.
Backup_Min_Object_Bytes=1024
