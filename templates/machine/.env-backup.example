# Бэкап баз данных девбокса.
#
#   cp .env-backup.example .env-backup && chmod 600 .env-backup
#
# ВАЖНО: этот файл намеренно НЕ добавлен в список --env-file в
# docker-compose.sh. Бэкап — не стек; лишний обязательный --env-file означал бы
# ещё один способ уронить ВСЕ compose-команды на машине разом, если файла нет.
# Читает его только scripts/backup.sh и его спутники.
#
# Из-за этого же host-setup.sh не найдёт .env-backup в списке, который он
# вычитывает из docker-compose.sh, — проверка на него добавлена там отдельно.

# ---------------------------------------------------------------------- S3

# Имя бакета. Без s3:// и без слэшей.
Backup_S3_Bucket=

# Префикс внутри бакета. Раскладка получается такая:
#   s3://<bucket>/<prefix>/postgres/<db>/<UTC-timestamp>.dump.gpg
#   s3://<bucket>/<prefix>/postgres/_globals/<UTC-timestamp>.sql.gpg
#   s3://<bucket>/<prefix>/sqlite/<имя базы без .db>/<UTC-timestamp>.db.gz.gpg
# Префикс на источник — чтобы lifecycle-правила и проверка свежести работали
# по каждому источнику отдельно, а не по бакету целиком.
Backup_S3_Prefix=devbox-asstnt

Backup_AWS_Region=us-east-1

# Пусто = использовать IAM instance role инстанса. Это предпочтительный путь:
# на машине не хранится ни одного долгоживущего ключа. Заполнять только если
# роли на инстансе нет.
Backup_AWS_Access_Key_Id=
Backup_AWS_Secret_Access_Key=

# ПРАВА, которых достаточно (и больше давать не надо): s3:PutObject и
# s3:ListBucket на <bucket>/<prefix>/*. s3:DeleteObject НЕ выдавать —
# скрипт с правом удалять в бакете с бэкапами это скрипт, который под чужими
# руками стирает всю историю. Ретенция в S3 делается lifecycle-политикой
# бакета, а не отсюда. В ту же политику стоит добавить
# AbortIncompleteMultipartUpload, иначе оборванные выгрузки копятся невидимо.

# --------------------------------------------------------------------- GPG

# Отпечаток или email получателя. Ключ ГЕНЕРИРУЕТСЯ НЕ НА ЭТОЙ МАШИНЕ:
# приватный ключ на девбоксе сводит на нет весь смысл шифрования — тот, кто
# получил машину, получил бы и данные. Здесь только публичная половина.
Backup_GPG_Recipient=

# Публичный ключ лежит в репозитории — он публичный. Импортируется в связку
# root'а при первом прогоне.
Backup_GPG_Pubkey=gpg/backup-pubkey.asc

# ------------------------------------------------- локальный буфер и место

# Каталог для временного файла и локальных поколений.
# ВНИМАНИЕ: /mnt/data на этой машине — НЕ отдельный том, это тот же
# /dev/nvme0n1p1, что и корень (27.08.2026: 25G, свободно 9.4G, занято 63%).
# Локальная копия конкурирует за место с данными postgres, образами docker и
# логами контейнеров.
Backup_Local_Dir=/mnt/data/backups

# Сколько поколений держать локально ПОСЛЕ успешной выгрузки в S3.
# 0 = не оставлять ничего, удалять сразу после подтверждения выгрузки.
# 1 — компромисс: быстрый откат без обращения к S3, ценой одного дампа на диске.
Backup_Local_Keep=1

# Нижняя граница свободного места. Прогон не начнётся, если после записи
# самого большого ожидаемого дампа (оценка по прошлому прогону, состояние в
# ${Backup_Local_Dir}/.last-sizes) свободного останется меньше. Локальные
# поколения при нехватке места сбрасываются ПЕРВЫМИ — бэкап всё равно уедет
# в S3. Бэкап, добивающий диск, — это не страховка, а вторая авария.
Backup_Min_Free_MB=1024

# ---------------------------------------------------------------- источники

# Имя контейнера postgres. Дамп снимается через `docker exec` этим
# контейнером, а не хостовым pg_dump: так версия клиента гарантированно
# совпадает с версией сервера, и пароль разворачивается внутри контейнера,
# не попадая ни в конфиг, ни в `ps`.
# Префикс в S3 для дампов общей СУБД. По умолчанию — имя стека-поставщика
# (mysql, pg). Машине, которая УЖЕ пишет в другой префикс, его надо указать
# здесь: смена префикса на работающей машине означает, что новые дампы уезжают
# в другое место, а check-backups.sh смотрит туда же и докладывает «бэкапов
# нет» при исправном бэкапе.
# Backup_DB_Prefix=postgres

# Список баз НЕ задаётся здесь намеренно — он спрашивается у самого postgres.
# Захардкоженный список означает, что следующая заведённая база молча
# останется без бэкапа, и узнается это при восстановлении.

# Всё, кроме баз общего postgres, объявляют САМИ СТЕКИ — ключами
# Backup_Sqlite / Backup_Files / Backup_Volume в stacks/<стек>/stack.conf.
# Здесь остаётся только то, что про машину: бакет, ключи, ротация, пороги.
#
# Учтите, что от имени файла SQLite зависит префикс в S3 (sqlite/<имя без
# .db>), и тот же префикс считает check-backups.sh: менять путь после первого
# прогона значит начать новую историю бэкапов под новым префиксом.

# ---------------------------------------------------------------- проверка

# scripts/check-backups.sh считает источник здоровым, если в S3 под его
# префиксом есть объект свежее указанного возраста и крупнее указанного
# размера. 26 часов, а не 24: суточный таймер с RandomizedDelaySec может
# сдвинуться, и проверка не должна поднимать тревогу из-за этого.
Backup_Max_Age_Hours=26

# Оборванный дамп почти всегда крошечный. Порог отсекает «файл есть, данных в
# нём нет» — отказ, который иначе выглядит как успех.
Backup_Min_Object_Bytes=1024
