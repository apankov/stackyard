# The entry points in a machine's root: <wrapper name>:<script in platform/bin>.
#
# One list for everyone. Held as two copies, adding a wrapper would mean
# remembering the second one: new machines would get it while existing machines
# would not, even after a version update.
#
# A wrapper is not about brevity. It sets ROOT_DIR explicitly, and that is the
# only thing distinguishing `./stack` from `./platform/bin/stack.sh`.
stack:stack.sh
dc:docker-compose.sh
host-setup:host-setup.sh
certs:certs.sh
registry:registry.sh
htpasswd:htpasswd.sh
memory:memory.sh
