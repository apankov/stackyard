# Notifications from this machine.
#
#   cp .env-notify.example .env-notify && chmod 600 .env-notify
#
# Like .env-backup, this file is NOT in docker-compose.sh's --env-file list:
# notifications are not a stack, and one more mandatory --env-file would be
# another way to break every compose command at once. Only notify.sh and
# watch-host.sh read it.

# ------------------------------------------------------------------ channel

# The bot token. A dedicated bot rather than a product one: a product token
# gets rotated sooner or later, the notifications go quiet, and silence here is
# indistinguishable from "all is well".
Notify_Telegram_Token=

# The group's chat_id (for groups it is NEGATIVE, e.g. -1001234567890).
# To find it: add the bot to the group, post any message there, then
#   curl -s "https://api.telegram.org/bot<TOKEN>/getUpdates" | tr ',' '\n' | grep -A2 '"chat"'
# A group rather than a direct message: alerts must not depend on one person
# being on holiday.
Notify_Telegram_Chat_Id=

# The emergency switch. With false the scripts still run and still write to the
# journal, but nothing is sent. It exists to mute the stream during planned
# work without removing the timers.
Notify_Enabled=true

# How this machine is called in an alert. The default is the name of the
# machine's directory — the same name fleet.sh and audit-isolation.sh use, so
# it is one name everywhere. Set it when the directory is not what you call the
# machine out loud.
#
# The host name goes into the alert next to it in parentheses: after a rebuild
# the label stays and the instance changes, and sometimes that is the whole
# story.
# Notify_Machine=devbox6

# --------------------------------------------------------- spam protection

# Do not repeat a message with the same key more often than once every this
# many hours. A unit failing hourly would otherwise produce 24 messages a day,
# the channel stops being read within a week — and that is worse than having no
# monitoring, because it looks like working monitoring. A RECOVERY message is
# always sent, regardless of the cooldown: without it there is no way to know
# whether the problem is over.
Notify_Cooldown_Hours=6

# ------------------------------------------------------------------- disk

# Space-separated. The mount points being watched. List only real, distinct
# mount points: two paths on the same partition produce two alerts about one
# disk.
Notify_Watch_Mounts=/

# Percentages USED. Both space and inodes are checked: inodes run out before
# space when there are many small files, and that failure looks like "there is
# space, but writes fail".
Notify_Disk_Warn_Percent=80
Notify_Disk_Crit_Percent=90

# ------------------------------------------------------------- containers

# How many restarts between watch-host.sh runs count as a crash loop. What is
# watched is the counter, not the status: `restart: always` shows "Up 3
# seconds" forever, and in `docker ps` a crash loop is indistinguishable from
# normal operation.
Notify_Restart_Delta=3

# Containers that are supposed to exit (one-shot migrations and initializers)
# are excluded automatically: watch-host.sh looks only at those whose restart
# policy is always or unless-stopped. This is for additional exclusions,
# space-separated, should any be needed.
Notify_Ignore_Containers=
