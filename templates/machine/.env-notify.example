# Оповещения девбокса в Telegram.
#
#   cp .env-notify.example .env-notify && chmod 600 .env-notify
#
# Как и .env-backup, этот файл НЕ входит в список --env-file в
# docker-compose.sh: оповещения — не стек, а лишний обязательный --env-file
# был бы ещё одним способом уронить все compose-команды разом. Читают его
# только scripts/notify.sh и scripts/watch-host.sh.

# ------------------------------------------------------------------ канал

# Токен от @BotFather. Отдельный бот, а не продуктовый: токен продуктового
# когда-нибудь ротируют, оповещения замолчат, а молчание здесь неотличимо от
# «всё хорошо».
Notify_Telegram_Token=

# chat_id группы (у групп он ОТРИЦАТЕЛЬНЫЙ, например -1001234567890).
# Как узнать: добавить бота в группу, написать там любое сообщение, затем
#   curl -s "https://api.telegram.org/bot<ТОКЕН>/getUpdates" | tr ',' '\n' | grep -A2 '"chat"'
# Группа, а не личка: алерты не должны зависеть от одного человека в отпуске.
Notify_Telegram_Chat_Id=

# Аварийный рубильник. false — скрипты отработают и напишут в журнал, но в
# Telegram ничего не уйдёт. Нужен, чтобы заглушить поток во время плановых
# работ, не снося таймеры.
Notify_Enabled=true

# --------------------------------------------------------- защита от спама

# Не повторять сообщение с тем же ключом чаще, чем раз в столько часов.
# Юнит, падающий ежечасно, иначе даёт 24 сообщения в сутки, канал перестают
# читать за неделю — и это хуже отсутствия мониторинга, потому что выглядит
# как работающий. Сообщение о ВОССТАНОВЛЕНИИ отправляется всегда, вне
# зависимости от cooldown: без него непонятно, кончилась ли проблема.
Notify_Cooldown_Hours=6

# ------------------------------------------------------------------- диск

# Через пробел. Точки монтирования, за которыми следим.
# На этой машине / и /mnt/data — один раздел, второй указывать незачем.
Notify_Watch_Mounts=/

# Проценты ЗАНЯТОГО. Проверяются и место, и inode: inode кончаются раньше
# места при множестве мелких файлов, и этот отказ выглядит как «место есть,
# а запись не идёт».
Notify_Disk_Warn_Percent=80
Notify_Disk_Crit_Percent=90

# ------------------------------------------------------------- контейнеры

# Сколько рестартов между прогонами watch-host.sh считать краш-лупом.
# Следим за счётчиком, а не за статусом: `restart: always` показывает
# «Up 3 seconds» бесконечно, и по `docker ps` краш-луп неотличим от нормы.
Notify_Restart_Delta=3

# Контейнеры, которым положено завершаться (one-shot миграции и
# инициализаторы), в наблюдение не берутся автоматически: watch-host.sh
# смотрит только на те, у кого политика рестарта always или unless-stopped.
# Здесь — дополнительные исключения через пробел, если понадобятся.
Notify_Ignore_Containers=
