[Unit]
Description=Weekly TLS certificate expiry check
Documentation=file:@DEPLOY_DIR@/platform/bin/check-certs.sh

[Timer]
# Понедельник, через несколько часов после ночного окна продления, чтобы
# проверка видела результат последнего запуска getssl, а не заставала его.
OnCalendar=Mon *-*-* 09:00:00
RandomizedDelaySec=15m
Persistent=true

[Install]
WantedBy=timers.target
