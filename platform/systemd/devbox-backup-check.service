[Unit]
Description=Verify that database backups exist and are fresh
Documentation=file:@DEPLOY_DIR@/platform/bin/check-backups.sh
Wants=network-online.target
After=network-online.target docker.service
# There are deliberately no path conditions -- this unit IS the insurance
# against silent downtime. A skipped unit does not count as failed, and we need
# exactly the opposite: being unable to check must be visible. That is why the
# script exits with code 2.
# Substituted by scripts/systemd.sh: an OnFailure line if notifications are
# configured (.env-notify), otherwise nothing. A unit with an OnFailure pointing
# at a handler that does not exist would work, but would clutter the journal.
@ONFAILURE@

[Service]
Type=oneshot
WorkingDirectory=@DEPLOY_DIR@
# As the repository owner, like getssl-check: root is not needed here -- the
# script only reads .env-backup, queries the database through docker and talks
# to S3.
User=@SERVICE_USER@

# A non-zero code -> the unit is failed -> it shows in `systemctl --failed`.
# That is the entire notification mechanism as of today. An external channel
# (mail, Telegram) is separate work, and it will plug in here.
ExecStart=@DEPLOY_DIR@/platform/bin/check-backups.sh

TimeoutStartSec=10min
