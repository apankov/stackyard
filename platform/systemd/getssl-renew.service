[Unit]
Description=Renew Let's Encrypt certificates via getssl
Documentation=https://github.com/srvrco/getssl
# getssl answers the HTTP-01 challenge through the nginx container and reloads
# it via RELOAD_CMD ("docker exec nginx nginx -s reload"), so Docker has to be
# up first.
Wants=network-online.target
After=network-online.target docker.service
# If the repository is not where it was expected, it is better not to start at
# all: otherwise getssl creates the working directory from scratch and registers
# a new ACME account.
ConditionPathIsDirectory=@DEPLOY_DIR@/state/getssl-config
# Substituted by scripts/systemd.sh: an OnFailure line if notifications are
# configured (.env-notify), otherwise nothing. A unit with an OnFailure pointing
# at a handler that does not exist would work, but would clutter the journal.
@ONFAILURE@

[Service]
Type=oneshot
User=@SERVICE_USER@

# Run from the MACHINE's state/, specifically. The shared
# getssl-config/getssl.cfg sets ACCOUNT_KEY="./getssl-config/account.key" -- a
# path relative to the current directory, not to whatever -w names. From any
# other place getssl generates a new 4096-bit ACME account key in the wrong spot
# and loses the existing account. The directory is the machine's and not the
# platform's on purpose: every machine must have its own account -- see
# scripts/certs.sh.
WorkingDirectory=@DEPLOY_DIR@/state

# -U, not -u. In getssl, -u means "--upgrade: download a fresh getssl and
# install it over itself", not "renew". A script that updates itself from the
# internet on a machine with five production vhosts is not something that should
# happen unattended at night. -U disables even the version check.
#
# Renewal itself has no flag of its own: -a walks every domain, and the decision
# to renew is made by RENEW_ALLOW="30" in getssl-config/getssl.cfg.
# -q leaves only the exceptional in the journal: errors and the fact of an
# issuance.
ExecStart=@DEPLOY_DIR@/state/bin/getssl -w ./getssl-config/ -U -a -q

# For Type=oneshot systemd DISABLES the start timeout by default. A hung getssl
# (waiting on DNS, an unreachable ACME server, CHECK_REMOTE pointing nowhere)
# would hang forever and block every later run -- i.e. the failure would look
# like "the timer is there, the renewals are not", exactly the one we are
# fixing.
TimeoutStartSec=30min
