[Unit]
Description=Weekly devbox status digest
Documentation=file:@DEPLOY_DIR@/platform/bin/notify.sh

[Timer]
# Monday, the start of the working day: somebody has to read the digest, and an
# unread digest is no different from an unsent one.
OnCalendar=Mon *-*-* 09:30:00
RandomizedDelaySec=10m
Persistent=true

[Install]
WantedBy=timers.target
