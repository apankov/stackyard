[Unit]
Description=Daily getssl renewal check
Documentation=https://github.com/srvrco/getssl

[Timer]
# Night time, when the machine is least loaded.
OnCalendar=*-*-* 05:23:00
# Let's Encrypt asks that not everyone arrive in the same second.
RandomizedDelaySec=30m
# If the machine was off at 05:23, the run happens after boot instead of being
# skipped silently.
Persistent=true

[Install]
WantedBy=timers.target
