[Unit]
Description=Daily verification of database backups
Documentation=file:@DEPLOY_DIR@/platform/bin/check-backups.sh

[Timer]
# Через час с небольшим после окна бэкапа (03:40 + до 20 минут разброса),
# чтобы проверка видела результат последнего прогона, а не заставала его.
OnCalendar=*-*-* 05:10:00
RandomizedDelaySec=10m
Persistent=true

[Install]
WantedBy=timers.target
