[Unit]
Description=Daily verification of database backups
Documentation=file:@DEPLOY_DIR@/platform/bin/check-backups.sh

[Timer]
# A little over an hour after the backup window (03:40 plus up to 20 minutes of
# jitter), so the check sees the result of the last run instead of catching it
# in progress.
OnCalendar=*-*-* 05:10:00
RandomizedDelaySec=10m
Persistent=true

[Install]
WantedBy=timers.target
