[Unit]
Description=Back up devbox databases to S3
Documentation=file:@DEPLOY_DIR@/docs/architecture/backup-design.md
# Dumps are taken through `docker exec` and uploaded to S3 -- both docker and
# the network are needed.
Wants=network-online.target
After=network-online.target docker.service
# There are deliberately NO path conditions here, for the same reason as in
# getssl-check.service: a unit whose Condition is not met is skipped and does
# NOT count as failed. A missing .env-backup must lead to failed -- which is why
# the script exits with code 2 -- and not to a quiet "no backups for a month".
# Substituted by scripts/systemd.sh: an OnFailure line if notifications are
# configured (.env-notify), otherwise nothing. A unit with an OnFailure pointing
# at a handler that does not exist would work, but would clutter the journal.
@ONFAILURE@

[Service]
Type=oneshot
WorkingDirectory=@DEPLOY_DIR@

# As root, unlike getssl-*, which run as the repository owner. The reason is
# concrete: the contents of the bind mounts belong to root (the same reason the
# stacks' rotators run as root), and `sqlite3 .backup` creates -wal and -shm
# files next to the database.
ExecStart=@DEPLOY_DIR@/platform/bin/backup.sh

# For Type=oneshot systemd DISABLES the start timeout by default. A hung dump
# (a locked table, an S3 endpoint that went away) would hang forever holding the
# lock, because of which every later run would silently never start -- i.e. the
# failure would look like "the timer is there, the backups are not".
TimeoutStartSec=1h

# Seven stacks run alongside on 916 MB of memory. A dump is a background job
# and must not take CPU and disk away from whatever is serving requests.
Nice=10
IOSchedulingClass=idle
