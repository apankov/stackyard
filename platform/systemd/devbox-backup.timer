[Unit]
Description=Daily database backup
Documentation=file:@DEPLOY_DIR@/docs/architecture/backup-design.md

[Timer]
# 03:40, а НЕ 05:23: там окно getssl-renew. Два тяжёлых процесса одновременно
# на машине с ~200 МБ свободной памяти встречаются с OOM-killer'ом, и
# проигрывает обычно тот, кто просил больше, — то есть pg_dump.
OnCalendar=*-*-* 03:40:00
RandomizedDelaySec=20m
# Машина была выключена в момент запуска — прогон произойдёт после загрузки,
# а не будет пропущен молча.
Persistent=true

[Install]
WantedBy=timers.target
