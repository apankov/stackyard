[Unit]
Description=Verify TLS certificate expiry dates
Documentation=file:@DEPLOY_DIR@/platform/bin/check-certs.sh
# There are deliberately no path conditions here. A unit whose Condition is not
# met is skipped and does NOT count as failed -- and this unit IS the insurance
# against silent downtime. A directory that has gone missing must lead to
# failed, so the script performs the check itself and exits with code 2.
# Substituted by scripts/systemd.sh: an OnFailure line if notifications are
# configured (.env-notify), otherwise nothing. A unit with an OnFailure pointing
# at a handler that does not exist would work, but would clutter the journal.
@ONFAILURE@

[Service]
Type=oneshot
User=@SERVICE_USER@
# A non-zero code -> the unit is failed -> it shows in `systemctl --failed`.
# That is the entire notification mechanism as of today.
ExecStart=@DEPLOY_DIR@/platform/bin/check-certs.sh
