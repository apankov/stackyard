[Unit]
Description=Periodic devbox host state check
Documentation=file:@DEPLOY_DIR@/platform/bin/watch-host.sh

[Timer]
# Каждые 15 минут. Диск на этой машине уходил от «всё нормально» к 500 МБ за
# часы, а не за дни: залипшая очередь писала лог гигабайтами. Суточной
# проверки на такой скорости не хватило бы.
OnCalendar=*:0/15
RandomizedDelaySec=2m
Persistent=false

[Install]
WantedBy=timers.target
