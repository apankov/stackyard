[Unit]
Description=Periodic devbox host state check
Documentation=file:@DEPLOY_DIR@/platform/bin/watch-host.sh

[Timer]
# Every 15 minutes. The disk on this machine went from "all fine" to 500 MB in
# hours rather than days: a stuck queue wrote its log by the gigabyte. A daily
# check would not keep up with that.
OnCalendar=*:0/15
RandomizedDelaySec=2m
Persistent=false

[Install]
WantedBy=timers.target
