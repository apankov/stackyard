[Unit]
Description=Report failure of %i to Telegram
Documentation=file:@DEPLOY_DIR@/platform/bin/notify.sh
# THIS unit has no OnFailure and cannot have one: a handler whose failure
# launches the handler is a loop. If sending fails, the unit goes to failed and
# shows in `systemctl --failed` -- i.e. it degrades exactly to the state that
# existed before notifications were added.
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=@DEPLOY_DIR@
# As root: the deduplication state lives in /var/lib/devbox-notify, and not
# every user can read journalctl for somebody else's unit.
ExecStart=@DEPLOY_DIR@/platform/bin/notify.sh --unit %i
# Three attempts of 15 seconds each inside the script, plus the pauses -- with
# room to spare.
TimeoutStartSec=3min
