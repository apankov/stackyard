[Unit]
Description=Nightly export of the access logs (Access_Export)
Documentation=file:@DEPLOY_DIR@/platform/bin/access-export.sh

[Timer]
# After midnight UTC, when yesterday is finished. The rotation at 00:05 does not
# matter to it: the export reads every generation.
OnCalendar=*-*-* 01:15:00 UTC
RandomizedDelaySec=15m
# A night missed while the machine was off is caught up after boot, while the
# logs still hold the day.
Persistent=true

[Install]
WantedBy=timers.target
