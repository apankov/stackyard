# vim: filetype=sh
#
# GENERATED FILE -- edits are overwritten by scripts/certs.sh.
# Template: platform/getssl-config/getssl.cfg.template
#
# The CA here is the PRODUCTION one and is set explicitly. The shared
# getssl-config/getssl.cfg points at staging, and every per-host config must
# override it: a host without this line silently gets a certificate no browser
# trusts, and that is visible only from a browser. Which is why the line lives
# in the template rather than in an instruction for a human.

DOMAIN=@DOMAIN@

CA="https://acme-v02.api.letsencrypt.org"

# Additional names in the same certificate. Substituted from the
# `domain+alias` form in a stack's Domains=; empty means there are no aliases.
SANS="@SANS@"

PREFIX='@DEPLOY_DIR@'

ACL=(${PREFIX}'/state/acme/.well-known/acme-challenge')
USE_SINGLE_ACL="true"

DOMAIN_CERT_LOCATION="${PREFIX}/state/certs/${DOMAIN}.crt"
DOMAIN_KEY_LOCATION="${PREFIX}/state/certs/${DOMAIN}.key"
DOMAIN_CHAIN_LOCATION="${PREFIX}/state/certs/${DOMAIN}-fullchain.crt"

# A reload, not a recreate: the certificate directory is mounted from the host,
# and recreating nginx while an upstream is down takes down every site on the
# machine.
# Without the repository owner being in the docker group the command silently
# does nothing, and nginx keeps the old certificate in memory -- the worst kind
# of failure, quiet and partial.
RELOAD_CMD="docker exec nginx nginx -s reload"

CHECK_REMOTE="true"
CHECK_REMOTE_WAIT="2"
